ATLASSIAN_SITE=https://gmdsoft.atlassian.net
ATLASSIAN_EMAIL=
# https://id.atlassian.com/manage-profile/security/api-tokens 에서 발급 (읽기 전용 용도)
ATLASSIAN_API_TOKEN=

# 로컬 개발 DB (docker-compose.dev.yml)
DATABASE_URL=postgres://rea:rea@localhost:5432/rea

# 여러 앱/관리 서비스가 세션 쿠키를 공유할 때 같은 값으로 지정 (미지정 시 server/data/.cookie-secret)
# COOKIE_SECRET=
# 프로필 이미지 업로드 프록시 대상 관리 서비스 (기본 http://127.0.0.1:3003)
# ORG_ADMIN_URL=http://127.0.0.1:3003
